# Thay ID theo log của GoodsReceiptDemoSeeder, không giả định ID cố định.
# Sau mỗi write thành công, chép Version mới nhất vào expectedVersion.
@baseUrl = http://localhost:5085
@staffId = 2
@managerId = 1
@inboundId = 1
@receiptId = 1
@itemId = 1
@binId = 1
@expectedVersion = PASTE_LATEST_BASE64_VERSION

### UC-15: danh sách phiếu trong kho được gán
GET {{baseUrl}}/api/goods-receipts?page=1&pageSize=20
X-Development-UserId: {{staffId}}

### UC-17: tạo Draft (201), lấy receiptId/itemId/version trong response
POST {{baseUrl}}/api/goods-receipts
X-Development-UserId: {{staffId}}
Content-Type: application/json

{
  "inboundRequestId": {{inboundId}}
}

### UC-16: đọc lại dữ liệu đã lưu
GET {{baseUrl}}/api/goods-receipts/{{receiptId}}
X-Development-UserId: {{staffId}}

### UC-50: quét một serial, nhận Version mới và ReceivedQty do server tính
POST {{baseUrl}}/api/goods-receipts/{{receiptId}}/items/{{itemId}}/serials
X-Development-UserId: {{staffId}}
Content-Type: application/json

{
  "expectedVersion": "{{expectedVersion}}",
  "serialCode": "DEMO-001",
  "sku": "GR-DEMO-SKU"
}

### UC-18 SAVE_DRAFT: chọn bin sau scan, dùng Version mới nhất
PUT {{baseUrl}}/api/goods-receipts/{{receiptId}}
X-Development-UserId: {{staffId}}
Content-Type: application/json

{
  "expectedVersion": "{{expectedVersion}}",
  "items": [
    { "itemId": {{itemId}}, "binId": {{binId}} }
  ]
}

### UC-18 SUBMIT: vẫn chưa tăng Stock
POST {{baseUrl}}/api/goods-receipts/{{receiptId}}/submit
X-Development-UserId: {{staffId}}
Content-Type: application/json

{ "expectedVersion": "{{expectedVersion}}" }

### Manager thấy ngay phiếu vừa submit
GET {{baseUrl}}/api/goods-receipts?status=PendingApproval
X-Development-UserId: {{managerId}}

### UC-56 APPROVE: tạo Serial/Movement, tăng Stock và refresh Inbound cùng transaction
POST {{baseUrl}}/api/goods-receipts/{{receiptId}}/approve
X-Development-UserId: {{managerId}}
Content-Type: application/json

{ "expectedVersion": "{{expectedVersion}}" }

### UC-56 REJECT: dùng một phiếu PendingApproval KHÁC, không dùng phiếu đã Approved
POST {{baseUrl}}/api/goods-receipts/{{receiptId}}/reject
X-Development-UserId: {{managerId}}
Content-Type: application/json

{
  "expectedVersion": "{{expectedVersion}}",
  "reason": "Hàng vỡ, thiếu phụ kiện"
}

### Tiến độ Inbound: chỉ cộng receipt Approved
GET {{baseUrl}}/api/inbound-requests/{{inboundId}}/receiving-progress
